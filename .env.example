# Intent Studio configuration (copy to .env; .env is git-ignored)

# Ollama server that hosts the models. NOTE: transcript text is sent to this machine.
OLLAMA_URL=http://localhost:11434

# Models
INTENT_STUDIO_LLM_MODEL=qwen3:8b
INTENT_STUDIO_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Analysis defaults (can be changed in the Settings UI)
INTENT_STUDIO_BATCH_SIZE=25
INTENT_STUDIO_CLUSTERING_SENSITIVITY=medium
INTENT_STUDIO_REQUEST_TIMEOUT=180
INTENT_STUDIO_AUTO_ACCEPT=true

# Web server binding (localhost only by default)
INTENT_STUDIO_HOST=127.0.0.1
INTENT_STUDIO_PORT=8000

# Optional paths
# INTENT_STUDIO_DB_PATH=backend/var/intent_studio.db
# INTENT_STUDIO_TAXONOMY_SEED=backend/data/taxonomy_seed.json
